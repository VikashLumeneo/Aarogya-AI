# Copy this file to ".env" and fill in the values. Never commit .env to git.

# Where form submissions are sent
TO_EMAIL=vikash@lumeneo.ai

# SMTP login of the mailbox that SENDS the emails.
# Google Workspace / Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
#   SMTP_USER=vikash@lumeneo.ai, SMTP_PASS=<16-letter App Password> (Google Account > Security > App passwords)
# Microsoft 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587
# Zoho: SMTP_HOST=smtp.zoho.in, SMTP_PORT=465
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=vikash@lumeneo.ai
SMTP_PASS=

# Sender shown to recipients (must be the SMTP mailbox or an alias of it)
FROM_EMAIL="ANVIQ <vikash@lumeneo.ai>"

# Send a "thanks, we got your request" email to the person who filled the form (true/false)
AUTO_REPLY=true
